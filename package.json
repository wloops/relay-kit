{
  "name": "ai-advisor-kit",
  "version": "0.1.0",
  "description": "Skills-first, CLI-assisted AI programming advisor workflow toolkit.",
  "type": "module",
  "bin": {
    "advisor": "dist/cli.js"
  },
  "files": [
    "dist",
    "docs/CLI_SPEC.md",
    "docs/FINAL_DESIGN.md",
    "docs/OPENSPEC_INTEGRATION.md",
    "docs/RUN_LANE_DESIGN.md",
    "docs/SKILLS_INSTALLATION.md",
    "docs/SMOKE_TESTS.md",
    "docs/USAGE_FLOW.md",
    "docs/V0_1_ALPHA_RELEASE.md",

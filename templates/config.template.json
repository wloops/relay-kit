{
  "projectName": "",
  "language": "zh",
  "mode": "simple",
  "handoffDir": "docs/agent-handoffs",
  "openSpecDir": "openspec",
  "sourceDirs": [
    "src",
    "apps",
    "packages"
  ],
  "packageManager": "auto",
  "devCommand": "",
  "buildCommand": "",
  "testCommand": "",
  "defaultExecutor": "opencode",
  "defaultAdvisor": "",
  "maxDiffLines": 500,
  "maxLogLines": 160,
  "includeGitDiff": true,
  "includeOpenSpec": false,
  "includePackageScripts": true,
  "runLayout": "runs-lanes",
  "defaultLane": "main",
  "excludePatterns": [
    ".env",
    ".env.*",
    "node_modules/",
    "dist/",
    "build/",
    "coverage/",
    ".git/",
    "*.pem",
    "*.key",
    "*.crt",
    "*.p12",
    "*.log"
  ],
  "skills": {
    "install": {
      "manager": true,
      "claudeProject": true,
      "codexProject": true,
      "claudeUser": false,
      "codexUser": false
    },
    "enabled": [
      "relay-planner",
      "relay-delegator",
      "relay-escalation",
      "relay-reviewer"
    ],
    "optional": [
      "relay-lane-planner",
      "relay-docs"
    ]
  }
}
